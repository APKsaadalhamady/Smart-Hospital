<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تطبيق الصيدلية الداخلية - التجهيز</title>
    <style>
        :root {
            --primary: #2c3e50;
            --secondary: #34495e;
            --success: #2ecc71;
            --danger: #e74c3c;
            --warning: #f39c12;
            --light: #f4f7f6;
            --border: #bdc3c7;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light);
            margin: 0; padding: 20px;
        }
        .dashboard {
            max-width: 900px; margin: 0 auto;
            background: #fff; padding: 20px;
            border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        h2 { color: var(--primary); border-bottom: 2px solid var(--border); padding-bottom: 10px; }
        
        /* أزرار التنقل الرئيسية */
        .main-nav { display: flex; gap: 10px; margin-bottom: 20px; }
        .nav-btn {
            flex: 1; padding: 15px; font-size: 16px; font-weight: bold;
            border: none; border-radius: 8px; cursor: pointer; color: #fff;
        }
        .btn-wards { background: var(--primary); }
        .btn-inventory { background: #8e44ad; }
        
        /* تبويبات الردهات */
        .ward-tabs { display: flex; gap: 10px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 5px;}
        .ward-tab {
            padding: 10px 20px; background: #ecf0f1; border-radius: 20px;
            cursor: pointer; font-weight: bold; border: 1px solid var(--border); white-space: nowrap;
        }
        .ward-tab.active { background: var(--primary); color: #fff; }
        .ward-badge {
            background: var(--danger); color: white; border-radius: 50%;
            padding: 2px 8px; font-size: 12px; margin-right: 5px;
        }

        /* جدول الطلبيات المجمعة */
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { padding: 12px; text-align: right; border-bottom: 1px solid #ddd; }
        th { background-color: var(--secondary); color: white; }
        tr:hover { background-color: #f9f9f9; }
        
        .total-qty { font-size: 18px; font-weight: bold; color: var(--primary); }
        .exceptional-row { background-color: #fff9e6; border-right: 4px solid var(--warning); }
        
        /* أزرار الإجراءات */
        .action-btn { padding: 8px 12px; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; color: white; margin-left: 5px;}
        .btn-prep { background: var(--success); }
        .btn-out { background: var(--danger); }
        
        /* حالة التجهيز */
        .prepared { background-color: #e8f8f5 !important; opacity: 0.8; }
        .prepared td { text-decoration: line-through; color: #7f8c8d; }
        .prepared .total-qty { text-decoration: none; color: var(--success); }

        .submit-ward-btn {
            width: 100%; padding: 15px; background: var(--primary); color: white;
            border: none; border-radius: 8px; font-size: 18px; font-weight: bold; cursor: pointer;
        }
        .hidden { display: none; }
    </style>
</head>
<body>

<div class="dashboard">
    <div class="main-nav">
        <button class="nav-btn btn-wards" onclick="switchMainTab('wards')">📋 تجهيز الردهات</button>
        <button class="nav-btn btn-inventory" onclick="switchMainTab('inventory')">⚙️ إدارة الأرصدة (الأدوية النافذة)</button>
    </div>

    <!-- قسم تجهيز الردهات -->
    <div id="wardsSection">
        <h2>الطلبات قيد التجهيز</h2>
        
        <div class="ward-tabs">
            <div class="ward-tab active" onclick="loadWard('الباطنية رجال')">الباطنية رجال <span class="ward-badge">2</span></div>
            <div class="ward-tab" onclick="loadWard('العناية المركزة')">العناية المركزة <span class="ward-badge">1</span></div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>المادة</th>
                    <th>الشكل</th>
                    <th>الجرعة</th>
                    <th>العدد الكلي للردهة</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody id="orderTableBody">
                <!-- سيتم توليد الصفوف هنا برمجياً -->
            </tbody>
        </table>

        <button class="submit-ward-btn" onclick="sendToAudit()">✅ الانتهاء ونقل سلة الردهة للتدقيق النهائي</button>
    </div>

    <!-- قسم إدارة المخزون (مخفي افتراضياً) -->
    <div id="inventorySection" class="hidden">
        <h2>إدارة حالة الأدوية</h2>
        <p style="color: #7f8c8d;">الأدوية التي يتم وسمها بـ "نافذ" لن تظهر للصيادلة السريريين في قائمة الطلب (تصبح حمراء).</p>
        
        <table>
            <thead>
                <tr>
                    <th>الاسم العلمي</th>
                    <th>الاسم التجاري</th>
                    <th>الحالة الحالية</th>
                    <th>تغيير الحالة</th>
                </tr>
            </thead>
            <tbody id="inventoryTableBody">
                <!-- بيانات المخزون -->
            </tbody>
        </table>
    </div>

</div>

<script>
    // 1. محاكاة لطلبات قادمة من الردهة (خلف الكواليس، النظام قام بجمعها)
    // لاحظ كيف جمعنا طلبات مرضى الباطنية لـ Flagyl وجعلناها رقماً واحداً (15)
    let aggregatedOrders = [
        { id: 1, name: "Metronidazole (Flagyl)", form: "Vial", dose: "500 mg", totalQty: 15, isExceptional: false, prepared: false },
        { id: 2, name: "Paracetamol", form: "Tablet", dose: "500 mg", totalQty: 30, isExceptional: false, prepared: false },
        { id: 3, name: "Clexane (Enoxaparin)", form: "Prefilled Syringe", dose: "4000 IU", totalQty: 2, isExceptional: true, note: "مطلوب بشكل طارئ - مريض جلطة", prepared: false }
    ];

    // 2. محاكاة لقاعدة بيانات الأدوية للتحكم بالتوفر
    let inventory = [
        { id: 1, name: "Metronidazole", brand: "Flagyl", available: true },
        { id: 2, name: "Ceftriaxone", brand: "Rocephin", available: false }, // نافذ حالياً
        { id: 3, name: "Paracetamol", brand: "Perfalgan", available: true }
    ];

    // التبديل بين شاشة الردهات وشاشة الرصيد
    function switchMainTab(tab) {
        document.getElementById('wardsSection').classList.toggle('hidden', tab !== 'wards');
        document.getElementById('inventorySection').classList.toggle('hidden', tab !== 'inventory');
        if(tab === 'inventory') renderInventory();
    }

    // رسم جدول طلبات الردهة
    function renderOrders() {
        const tbody = document.getElementById('orderTableBody');
        tbody.innerHTML = '';
        
        aggregatedOrders.forEach((order, index) => {
            const row = document.createElement('tr');
            if (order.prepared) row.className = 'prepared';
            if (order.isExceptional && !order.prepared) row.classList.add('exceptional-row');
            
            // إضافة ملاحظة الطلب الاستثنائي إن وجدت
            const nameDisplay = order.isExceptional 
                ? `<b>${order.name}</b> <br><small style="color:var(--danger)">⚠️ استثنائي: ${order.note}</small>` 
                : `<b>${order.name}</b>`;

            row.innerHTML = `
                <td>${nameDisplay}</td>
                <td>${order.form}</td>
                <td>${order.dose}</td>
                <td class="total-qty">${order.totalQty}</td>
                <td>
                    ${!order.prepared ? 
                        `<button class="action-btn btn-prep" onclick="markPrepared(${index})">تجهيز</button>
                         <button class="action-btn btn-out" onclick="markOutOfStock('${order.name}', ${index})">نفاد</button>` 
                        : '<span style="color:var(--success); font-weight:bold;">تم التجهيز ✓</span>'
                    }
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    // تجهيز الدواء (شطب السطر)
    function markPrepared(index) {
        aggregatedOrders[index].prepared = true;
        renderOrders();
    }

    // إعلان نفاذ الدواء (السحر يحدث هنا)
    function markOutOfStock(drugName, index) {
        if(confirm(`هل أنت متأكد من نفاذ ${drugName}؟ سيتم حظره من شاشات جميع الردهات فوراً!`)) {
            // 1. إزالة الطلب من قائمة التجهيز
            aggregatedOrders.splice(index, 1);
            
            // 2. تحديث قاعدة البيانات المركزية (تصبح available: false)
            // في الواقع يتم إرسال هذا التحديث لـ Firebase
            alert(`تم تحويل ${drugName} إلى حالة (غير متوفر 🔴). لن يتمكن الصيادلة السريريون من طلبه بعد الآن.`);
            
            renderOrders();
        }
    }

    // إرسال الطلبية للتدقيق
    function sendToAudit() {
        const allPrepared = aggregatedOrders.every(o => o.prepared);
        if (!allPrepared) {
            alert('يجب التعامل مع جميع الأدوية (إما تجهيز أو إعلان نفاذ) قبل نقل السلة للتدقيق!');
            return;
        }
        alert('تم رفع سلة ردهة (الباطنية رجال) إلى قسم التدقيق بنجاح!');
        aggregatedOrders = []; // تصفير الجدول
        renderOrders();
    }

    // --- قسم إدارة المخزون ---
    function renderInventory() {
        const tbody = document.getElementById('inventoryTableBody');
        tbody.innerHTML = '';
        inventory.forEach((drug, index) => {
            const row = document.createElement('tr');
            const statusText = drug.available ? '<span style="color:var(--success)">متوفر 🟢</span>' : '<span style="color:var(--danger)">نافذ 🔴</span>';
            const actionBtn = drug.available 
                ? `<button class="action-btn btn-out" onclick="toggleStock(${index}, false)">إعلان نفاذ</button>`
                : `<button class="action-btn btn-prep" onclick="toggleStock(${index}, true)">إعادة توفير</button>`;
                
            row.innerHTML = `
                <td>${drug.name}</td>
                <td>${drug.brand}</td>
                <td><b>${statusText}</b></td>
                <td>${actionBtn}</td>
            `;
            tbody.appendChild(row);
        });
    }

    function toggleStock(index, isAvailable) {
        inventory[index].available = isAvailable;
        // هنا يتم إرسال الإشارة لـ Firebase ليتم تحديث هواتف السريريين فوراً
        renderInventory();
    }

    // التشغيل الأولي
    window.onload = () => renderOrders();
</script>
</body>
</html>
